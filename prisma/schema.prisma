// Diário das Obras — data architecture v1 (multi-sector inspection platform).
// Convention: English snake_case plural table names via @@map; Prisma models
// PascalCase singular. See docs/arquitetura-dados-nova-versao-v1.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ConversationStep {
  MAIN_MENU
  ACTION_MENU
  SELECT_EMPRESA
  AWAITING_PHOTO
  AWAITING_DESCRIPTION
  AWAITING_POST_SAVE_CHOICE
  AWAITING_INSPECT_DATE
  SELECT_EMPRESA_FOR_REPORT
  AWAITING_REPORT_DATE
  AWAITING_SERVICE_TYPE
  AWAITING_PROCEDURE_NUMBER
  SELECT_EMPRESA_FOR_TRAINING
  AWAITING_TRAINING_TEMA
  AWAITING_TRAINING_PARTICIPANTS
  AWAITING_TRAINING_DATES
  AWAITING_TRAINING_PHOTO
  AWAITING_TRAINING_FILE
}

enum EntityType {
  STANDARD
  PERSON
  MACHINE
  ASSET
}

enum MentionSource {
  CODE
  AI
  MANUAL
  QR
}

enum AlertType {
  PERSON_NOT_TRAINED
  MACHINE_NO_INSPECTION
  MACHINE_INSPECTION_EXPIRED
  STANDARD_NOT_FOUND
}

enum AlertSeverity {
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum CompetencyStatus {
  TRAINED
  PENDING
  EXPIRED
}

enum PersonStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum PanelUserRole {
  ADMIN
  MANAGER
}

enum InspectionResult {
  APPROVED
  REJECTED
}

enum ItemResult {
  OK
  NOK
  NA
}

/// Tipo de atendimento da mobilização técnica (Relatórios Técnicos Bykonz).
enum AttendanceType {
  SITE_SURVEY
  INSTALLATION
  MAINTENANCE
  DIAGNOSIS
  COMMISSIONING
  TECHNICAL_SUPPORT
}

/// Status de uma pendência técnica sugerida pela IA ou cadastrada manualmente.
enum PendingStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ---------------------------------------------------------------------------
// Multi-sector configuration
// ---------------------------------------------------------------------------

model Sector {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assetTypes         AssetType[]
  codePrefixes       CodePrefix[]
  projects           Project[]
  assets             Asset[]
  standards          Standard[]
  people             Person[]
  machines           Machine[]
  checklistTemplates ChecklistTemplate[]
  entries            Entry[]

  @@map("sectors")
}

model AssetType {
  id           Int    @id @default(autoincrement())
  sectorId     Int    @map("sector_id")
  code         String
  name         String
  level        Int
  parentTypeId Int?   @map("parent_type_id")

  sector   Sector      @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  parent   AssetType?  @relation("AssetTypeHierarchy", fields: [parentTypeId], references: [id], onDelete: SetNull)
  children AssetType[] @relation("AssetTypeHierarchy")
  assets   Asset[]

  @@unique([sectorId, code])
  @@index([sectorId])
  @@map("asset_types")
}

model CodePrefix {
  id         Int        @id @default(autoincrement())
  sectorId   Int?       @map("sector_id")
  prefix     String
  entityType EntityType @map("entity_type")

  sector Sector? @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@unique([sectorId, prefix])
  @@index([prefix])
  @@map("code_prefixes")
}

// ---------------------------------------------------------------------------
// Companies, projects and assets
// ---------------------------------------------------------------------------

model Company {
  id        BigInt   @id @default(autoincrement())
  name      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userLinks UserCompany[]
  projects  Project[]
  people    Person[]
  entries   Entry[]
  vessels   Vessel[]

  @@map("companies")
}

model Vessel {
  id           Int      @id @default(autoincrement())
  companyId    BigInt?  @map("company_id")
  name         String
  code         String?
  imo          String?
  mmsi         String?
  vesselType   String?  @map("vessel_type")
  vesselClass  String?  @map("vessel_class")
  flag         String?
  port         String?
  location     String?
  model        String?
  manufacturer String?
  observations String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company                Company?                @relation(fields: [companyId], references: [id], onDelete: SetNull)
  mobilizations          VesselMobilization[]
  reports                VesselReport[]
  memories               TechnicalMemory[]
  technicalMobilizations TechnicalMobilization[]

  @@map("vessels")
}

model VesselMobilization {
  id               Int       @id @default(autoincrement())
  vesselId         Int       @map("vessel_id")
  reportCode       String    @unique @map("report_code")
  title            String?
  serviceType      String?   @map("service_type")
  objective        String?
  location         String?
  technicianName   String?   @map("technician_name")
  mobilizationDate DateTime? @map("mobilization_date")
  status           String    @default("DRAFT")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  vessel        Vessel               @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  evidences     VesselEvidence[]
  pendingIssues VesselPendingIssue[]
  equipment     VesselEquipment[]
  reports       VesselReport[]

  @@map("vessel_mobilizations")
}

model VesselEvidence {
  id             Int      @id @default(autoincrement())
  mobilizationId Int      @map("mobilization_id")
  category       String
  observation    String?
  description    String?
  ocrText        String?  @map("ocr_text")
  attachmentType String?  @map("attachment_type")
  attachmentMime String?  @map("attachment_mime")
  attachmentData String?  @map("attachment_data")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  mobilization VesselMobilization @relation(fields: [mobilizationId], references: [id], onDelete: Cascade)

  @@map("vessel_evidences")
}

model VesselPendingIssue {
  id             Int      @id @default(autoincrement())
  mobilizationId Int      @map("mobilization_id")
  system         String
  description    String
  responsible    String?
  status         String   @default("OPEN")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  mobilization VesselMobilization @relation(fields: [mobilizationId], references: [id], onDelete: Cascade)

  @@map("vessel_pending_issues")
}

model VesselEquipment {
  id             Int      @id @default(autoincrement())
  mobilizationId Int      @map("mobilization_id")
  name           String
  manufacturer   String?
  model          String?
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  mobilization VesselMobilization @relation(fields: [mobilizationId], references: [id], onDelete: Cascade)

  @@map("vessel_equipment")
}

model VesselReport {
  id             Int      @id @default(autoincrement())
  vesselId       Int      @map("vessel_id")
  mobilizationId Int      @map("mobilization_id")
  title          String
  reportCode     String   @map("report_code")
  summary        String?
  conclusion     String?
  content        String
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vessel       Vessel             @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  mobilization VesselMobilization @relation(fields: [mobilizationId], references: [id], onDelete: Cascade)

  @@map("vessel_reports")
}

model Project {
  id                        Int      @id @default(autoincrement())
  companyId                 BigInt   @map("company_id")
  sectorId                  Int      @map("sector_id")
  code                      String
  name                      String
  status                    String   @default("ACTIVE")
  attributes                Json?
  whatsappGroupId           String?  @map("whatsapp_group_id")
  whatsappAutoReportEnabled Boolean  @default(false) @map("whatsapp_auto_report_enabled")
  // Auto-report por e-mail (independente do WhatsApp): lista de destinatários e
  // flag de habilitação. O disparo diário envia o mesmo PDF por e-mail quando
  // habilitado e há registros no dia.
  reportEmailRecipients     String[] @default([]) @map("report_email_recipients")
  emailAutoReportEnabled    Boolean  @default(false) @map("email_auto_report_enabled")
  // Próximo número sequencial a atribuir ao diário de obra (DO) deste projeto.
  // Configurado uma vez por projeto (via backend) para dar continuidade à
  // numeração manual; incrementa a cada novo dia que gera relatório.
  diaryNextSequence         Int?     @map("diary_next_sequence")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sector                 Sector                  @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  assets                 Asset[]
  machines               Machine[]
  people                 Person[]
  entries                Entry[]
  dailyReportNumbers     DailyReportNumber[]
  technicalMobilizations TechnicalMobilization[]

  @@unique([companyId, code])
  @@index([sectorId])
  @@map("projects")
}

/// Numeração sequencial do diário de obra (DO) por dia. O número é atribuído
/// na primeira geração de um dia com registros e reusado em regerações, para
/// que painel, bot e cron produzam sempre o mesmo nome de arquivo.
model DailyReportNumber {
  id         Int      @id @default(autoincrement())
  projectId  Int      @map("project_id")
  reportDate DateTime @map("report_date") @db.Date
  sequence   Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, reportDate])
  @@map("daily_report_numbers")
}

model TechnicalMobilization {
  id               Int             @id @default(autoincrement())
  projectId        Int             @map("project_id")
  // Vinculo opcional com a embarcação (modelo Vessel) para o histórico técnico
  // permanente por embarcação e para a memória de IA.
  vesselId         Int?            @map("vessel_id")
  reportCode       String          @unique @map("report_code")
  clientName       String?         @map("client_name")
  vesselName       String?         @map("vessel_name")
  serviceType      String?         @map("service_type")
  // Tipo estruturado de atendimento (Site Survey, Instalação, Manutenção, ...).
  attendanceType   AttendanceType? @map("attendance_type")
  siteLocation     String?         @map("site_location")
  mobilizationDate DateTime?       @map("mobilization_date")
  technicianName   String?         @map("technician_name")
  objective        String?
  status           String          @default("DRAFT")
  // Resumo da memória técnica acumulada da embarcação (gerado pela IA a partir
  // dos relatórios anteriores) consultado na geração do relatório atual.
  aiMemorySummary  String?         @map("ai_memory_summary")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  project       Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vessel        Vessel?                 @relation(fields: [vesselId], references: [id], onDelete: SetNull)
  evidences     TechnicalEvidence[]
  pendingIssues TechnicalPendingIssue[]
  equipment     TechnicalEquipment[]
  inventory     TechnicalInventory[]
  reports       TechnicalReport[]

  @@index([vesselId])
  @@map("technical_mobilizations")
}

model TechnicalEvidence {
  id                  Int      @id @default(autoincrement())
  mobilizationId      Int      @map("mobilization_id")
  category            String
  // Pequena observação do técnico (opcional).
  observation         String?
  // Descrição técnica gerada automaticamente pela IA (editável pelo técnico).
  aiDescription       String?  @map("ai_description")
  // Confiança da classificação/descrição da IA (0..1).
  aiConfidence        Float?   @map("ai_confidence")
  // Tags técnicas identificadas pela IA (ex.: switch, rack, ipc, camera).
  aiTags              String[] @default([]) @map("ai_tags")
  // Equipamentos identificados pela IA na imagem (ex.: "Siemens IoT2050").
  equipmentIdentified String[] @default([]) @map("equipment_identified")
  manufacturer        String?
  model               String?
  serialNumber        String?  @map("serial_number")
  // Texto OCR extraído (etiquetas, alarmes, telas de supervisório).
  ocrText             String?  @map("ocr_text")
  // Ordem automática de organização dentro da categoria (definida pela IA).
  orderIndex          Int      @default(0) @map("order_index")
  attachmentType      String?  @map("attachment_type")
  attachmentMime      String?  @map("attachment_mime")
  attachmentData      String?  @map("attachment_data")
  // URLs adicionais (vídeo/documento opcionais) gerenciadas pelo S3.
  videoUrl            String?  @map("video_url")
  documentUrl         String?  @map("document_url")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  mobilization TechnicalMobilization @relation(fields: [mobilizationId], references: [id], onDelete: Cascade)

  @@index([mobilizationId, category])
  @@map("technical_evidences")
}

model TechnicalPendingIssue {
  id             Int           @id @default(autoincrement())
  mobilizationId Int           @map("mobilization_id")
  system         String
  description    String
  responsible    String?
  // Sugerida pela IA (true) ou cadastrada manualmente (false).
  suggestedByAi  Boolean       @default(false) @map("suggested_by_ai")
  status         PendingStatus @default(OPEN)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  mobilization TechnicalMobilization @relation(fields: [mobilizationId], references: [id], onDelete: Cascade)

  @@index([mobilizationId, status])
  @@map("technical_pending_issues")
}

model TechnicalEquipment {
  id             Int      @id @default(autoincrement())
  mobilizationId Int      @map("mobilization_id")
  name           String
  manufacturer   String?
  model          String?
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  mobilization TechnicalMobilization @relation(fields: [mobilizationId], references: [id], onDelete: Cascade)

  @@map("technical_equipment")
}

model TechnicalInventory {
  id             Int      @id @default(autoincrement())
  mobilizationId Int      @map("mobilization_id")
  name           String
  category       String?
  quantity       Int      @default(1)
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  mobilization TechnicalMobilization @relation(fields: [mobilizationId], references: [id], onDelete: Cascade)

  @@map("technical_inventory")
}

/// Memória técnica permanente por embarcação: guarda o embedding do conteúdo
/// dos relatórios anteriores para permitir consultas semânticas (IA) e
/// identificar pendências recorrentes, equipamentos instalados e evolução.
model TechnicalMemory {
  id          Int      @id @default(autoincrement())
  vesselId    Int      @map("vessel_id")
  reportId    Int?     @map("report_id")
  contentType String   @default("TEXT") @map("content_type") // TEXT | VECTOR
  content     String
  // Vetor de embedding (JSON serializado) para busca semântica.
  embedding   Json?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  vessel Vessel?          @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  report TechnicalReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([vesselId, createdAt])
  @@map("technical_memories")
}

model TechnicalReport {
  id             Int       @id @default(autoincrement())
  mobilizationId Int       @map("mobilization_id")
  title          String
  reportCode     String    @map("report_code")
  summary        String?
  conclusion     String?
  content        String
  metadata       Json?
  // Token público para compartilhamento por link (expirável).
  shareToken     String?   @unique @map("share_token")
  shareExpiresAt DateTime? @map("share_expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  mobilization        TechnicalMobilization @relation(fields: [mobilizationId], references: [id], onDelete: Cascade)
  memories            TechnicalMemory[]
  technicalSignatures TechnicalSignature[]

  @@index([mobilizationId])
  @@map("technical_reports")
}

/// Assinaturas digitais do relatório (técnico, cliente, responsável técnico).
model TechnicalSignature {
  id            Int      @id @default(autoincrement())
  reportId      Int      @map("report_id")
  role          String
  name          String
  // Assinatura digital (hash/assinatura criptográfica) ou URL da imagem.
  signatureData String?  @map("signature_data")
  signedAt      DateTime @default(now()) @map("signed_at") @db.Timestamptz(6)

  report TechnicalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("technical_signatures")
}

model Asset {
  id            Int     @id @default(autoincrement())
  projectId     Int     @map("project_id")
  sectorId      Int     @map("sector_id")
  assetTypeId   Int     @map("asset_type_id")
  parentAssetId Int?    @map("parent_asset_id")
  code          String
  name          String
  attributes    Json?
  qrcodeToken   String? @unique @map("qrcode_token")
  active        Boolean @default(true)

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sector      Sector            @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  assetType   AssetType         @relation(fields: [assetTypeId], references: [id], onDelete: Restrict)
  parent      Asset?            @relation("AssetTree", fields: [parentAssetId], references: [id], onDelete: SetNull)
  children    Asset[]           @relation("AssetTree")
  entries     Entry[]
  inspections AssetInspection[]

  @@unique([sectorId, code])
  @@index([projectId])
  @@index([parentAssetId])
  @@map("assets")
}

// ---------------------------------------------------------------------------
// Standards, people and competencies
// ---------------------------------------------------------------------------

model Standard {
  id          Int     @id @default(autoincrement())
  sectorId    Int     @map("sector_id")
  code        String
  title       String
  description String?
  version     String?
  active      Boolean @default(true)
  attributes  Json?

  sector       Sector       @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  competencies Competency[]

  @@unique([sectorId, code])
  @@map("standards")
}

model Person {
  id               Int          @id @default(autoincrement())
  sectorId         Int          @map("sector_id")
  companyId        BigInt?      @map("company_id")
  projectId        Int?         @map("project_id")
  name             String
  registrationCode String?      @map("registration_code")
  role             String?
  status           PersonStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  sector           Sector              @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  company          Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  project          Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  aliases          PersonAlias[]
  competencies     Competency[]
  inspections      MachineInspection[] @relation("Inspector")
  assetInspections AssetInspection[]   @relation("AssetInspector")

  @@unique([sectorId, registrationCode])
  @@index([projectId])
  @@map("people")
}

model PersonAlias {
  id       Int    @id @default(autoincrement())
  personId Int    @map("person_id")
  alias    String

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, alias])
  @@index([alias])
  @@map("person_aliases")
}

model Competency {
  id             Int              @id @default(autoincrement())
  personId       Int              @map("person_id")
  standardId     Int              @map("standard_id")
  status         CompetencyStatus
  trainedAt      DateTime?        @map("trained_at") @db.Timestamptz(6)
  validUntil     DateTime?        @map("valid_until") @db.Timestamptz(6)
  certificateUrl String?          @map("certificate_url")

  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  standard Standard @relation(fields: [standardId], references: [id], onDelete: Restrict)

  @@unique([personId, standardId])
  @@map("competencies")
}

// ---------------------------------------------------------------------------
// Machines, checklists and inspections
// ---------------------------------------------------------------------------

model Machine {
  id         Int     @id @default(autoincrement())
  sectorId   Int     @map("sector_id")
  projectId  Int?    @map("project_id")
  code       String
  name       String
  type       String?
  status     String  @default("ACTIVE")
  attributes Json?

  sector      Sector              @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  project     Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  inspections MachineInspection[]

  @@unique([sectorId, code])
  @@map("machines")
}

model ChecklistTemplate {
  id           Int    @id @default(autoincrement())
  sectorId     Int    @map("sector_id")
  application  String
  name         String
  validityDays Int?   @map("validity_days")

  sector           Sector              @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  items            ChecklistItem[]
  inspections      MachineInspection[]
  assetInspections AssetInspection[]

  @@map("checklist_templates")
}

model ChecklistItem {
  id          Int     @id @default(autoincrement())
  templateId  Int     @map("template_id")
  position    Int
  description String
  required    Boolean @default(true)

  template               ChecklistTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  inspectionResults      MachineInspectionItem[]
  assetInspectionResults AssetInspectionItem[]

  @@unique([templateId, position])
  @@map("checklist_items")
}

model MachineInspection {
  id                Int              @id @default(autoincrement())
  machineId         Int              @map("machine_id")
  templateId        Int              @map("template_id")
  inspectedAt       DateTime         @map("inspected_at") @db.Timestamptz(6)
  inspectorPersonId Int?             @map("inspector_person_id")
  result            InspectionResult
  validUntil        DateTime?        @map("valid_until") @db.Timestamptz(6)
  notes             String?

  machine   Machine                 @relation(fields: [machineId], references: [id], onDelete: Cascade)
  template  ChecklistTemplate       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  inspector Person?                 @relation("Inspector", fields: [inspectorPersonId], references: [id], onDelete: SetNull)
  items     MachineInspectionItem[]

  @@index([machineId, inspectedAt])
  @@map("machine_inspections")
}

model MachineInspectionItem {
  id              Int        @id @default(autoincrement())
  inspectionId    Int        @map("inspection_id")
  checklistItemId Int        @map("checklist_item_id")
  result          ItemResult
  note            String?

  inspection    MachineInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItem     @relation(fields: [checklistItemId], references: [id], onDelete: Restrict)

  @@unique([inspectionId, checklistItemId])
  @@map("machine_inspection_items")
}

model AssetInspection {
  id                Int              @id @default(autoincrement())
  assetId           Int              @map("asset_id")
  templateId        Int              @map("template_id")
  inspectedAt       DateTime         @map("inspected_at") @db.Timestamptz(6)
  inspectorPersonId Int?             @map("inspector_person_id")
  result            InspectionResult
  validUntil        DateTime?        @map("valid_until") @db.Timestamptz(6)
  notes             String?

  asset     Asset                 @relation(fields: [assetId], references: [id], onDelete: Cascade)
  template  ChecklistTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  inspector Person?               @relation("AssetInspector", fields: [inspectorPersonId], references: [id], onDelete: SetNull)
  items     AssetInspectionItem[]

  @@index([assetId, inspectedAt])
  @@map("asset_inspections")
}

model AssetInspectionItem {
  id              Int        @id @default(autoincrement())
  inspectionId    Int        @map("inspection_id")
  checklistItemId Int        @map("checklist_item_id")
  result          ItemResult
  note            String?

  inspection    AssetInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItem   @relation(fields: [checklistItemId], references: [id], onDelete: Restrict)

  @@unique([inspectionId, checklistItemId])
  @@map("asset_inspection_items")
}

// ---------------------------------------------------------------------------
// Manager panel accounts — distinct from `User` (WhatsApp bot operators) and
// from `people` (workforce cited in captions). Login credentials for the
// web panel only.
// ---------------------------------------------------------------------------

model PanelUser {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String        @map("password_hash")
  name         String
  role         PanelUserRole @default(MANAGER)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  editedEntries Entry[]

  @@map("panel_users")
}

// ---------------------------------------------------------------------------
// Bot operators (WhatsApp users) — distinct from `people` (workforce cited in
// captions); see docs §8.
// ---------------------------------------------------------------------------

model User {
  id             Int      @id @default(autoincrement())
  phoneE164      String   @unique @map("phone_e164")
  // Identidade do operador no Telegram (numérica, como string). Fica ao lado do
  // telefone: o match de acesso passa a ser por telefone (WhatsApp) OU por
  // telegram id (Telegram). Ver docs/plano-suporte-telegram.md.
  telegramUserId String?  @unique @map("telegram_user_id")
  name           String?
  role           String?
  // Libera/bloqueia a resposta do bot sem apagar o registro (entries preservados).
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  companies UserCompany[]
  entries   Entry[]

  @@map("users")
}

model UserCompany {
  userId    Int    @map("user_id")
  companyId BigInt @map("company_id")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@map("user_companies")
}

// ---------------------------------------------------------------------------
// Diary entries, mentions and alerts
// ---------------------------------------------------------------------------

model Entry {
  id                  BigInt    @id @default(autoincrement())
  userId              Int       @map("user_id")
  companyId           BigInt?   @map("company_id")
  projectId           Int?      @map("project_id")
  sectorId            Int?      @map("sector_id")
  assetId             Int?      @map("asset_id")
  category            String?
  description         String?
  serviceType         String?   @map("service_type")
  procedureNumber     String?   @map("procedure_number")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  // Correção de texto feita pelo painel (o bot é append-only): apenas a
  // descrição é editável — foto, obra, data e autor são imutáveis. O texto
  // anterior fica na trilha de auditoria (action entry.description.updated);
  // estas colunas existem para o painel marcar o registro como "editado".
  editedAt            DateTime? @map("edited_at") @db.Timestamptz(6)
  editedByPanelUserId Int?      @map("edited_by_panel_user_id")

  user     User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  company  Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  project  Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sector   Sector?        @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  asset    Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  editedBy PanelUser?     @relation(fields: [editedByPanelUserId], references: [id], onDelete: SetNull)
  media    EntryMedia[]
  training Training?
  mentions EntryMention[]
  alerts   Alert[]

  @@index([companyId, category, createdAt])
  @@index([projectId, createdAt])
  @@map("entries")
}

model EntryMedia {
  id        BigInt  @id @default(autoincrement())
  entryId   BigInt  @map("entry_id")
  mediaUrl  String  @map("media_url")
  mediaType String? @map("media_type")

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("entry_media")
}

model Training {
  id           Int      @id @default(autoincrement())
  entryId      BigInt   @unique @map("entry_id")
  topic        String
  participants String?
  startsAt     DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime @map("ends_at") @db.Timestamptz(6)

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@map("trainings")
}

/// Key table of the hybrid identification path: every entity detected in a
/// caption becomes a link with provenance (source) and confidence.
/// Polymorphic target (entityType + entityId) — no physical FK by design.
model EntryMention {
  id          Int           @id @default(autoincrement())
  entryId     BigInt        @map("entry_id")
  entityType  EntityType    @map("entity_type")
  entityId    Int?          @map("entity_id")
  source      MentionSource
  confidence  Float?
  matchedText String?       @map("matched_text")
  confirmed   Boolean       @default(false)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  entry  Entry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  alerts Alert[]

  @@index([entryId])
  @@index([entityType, entityId])
  @@index([source, confirmed])
  @@map("entry_mentions")
}

/// Snapshot of a compliance problem at the moment of the entry — persisted,
/// never recalculated (training/inspection status changes over time).
model Alert {
  id         Int           @id @default(autoincrement())
  entryId    BigInt        @map("entry_id")
  mentionId  Int?          @map("mention_id")
  type       AlertType
  severity   AlertSeverity
  title      String
  detail     String?
  status     AlertStatus   @default(OPEN)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime?     @map("resolved_at") @db.Timestamptz(6)

  entry   Entry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  mention EntryMention? @relation(fields: [mentionId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([entryId])
  @@map("alerts")
}

// ---------------------------------------------------------------------------
// WhatsApp conversation state (bot session machine)
// ---------------------------------------------------------------------------

model WhatsappConversationState {
  id                           BigInt           @id @default(autoincrement())
  chatId                       String           @unique @map("chat_id")
  phoneE164                    String           @map("phone_e164")
  step                         ConversationStep
  flowKey                      String?          @map("flow_key")
  stepKey                      String?          @map("step_key")
  flowData                     Json?            @map("flow_data")
  selectedCategory             String?          @map("selected_category")
  selectedCompanyId            BigInt?          @map("selected_company_id")
  selectedServiceType          String?          @map("selected_service_type")
  selectedProcedureNumber      String?          @map("selected_procedure_number")
  selectedTrainingTopic        String?          @map("selected_training_topic")
  selectedTrainingParticipants String?          @map("selected_training_participants")
  selectedTrainingStartsAt     DateTime?        @map("selected_training_starts_at") @db.Timestamptz(6)
  selectedTrainingEndsAt       DateTime?        @map("selected_training_ends_at") @db.Timestamptz(6)
  selectedTrainingPhotoCount   Int?             @map("selected_training_photo_count")
  pendingEntryId               BigInt?          @map("pending_entry_id")
  createdAt                    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("whatsapp_conversation_states")
}

// Trilha de auditoria (fase 1: relatórios). Polimórfico e sem FK física — o
// ator/entidade variam entre painel (PanelUser), bot (User) e cron (SYSTEM),
// e os ids das entidades são de tipos mistos (Int/BigInt), então guardamos
// como String. Gravação é best-effort e nunca bloqueia o fluxo principal.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorType  String   @map("actor_type") // SYSTEM | PANEL_USER | BOT_USER
  actorId    String?  @map("actor_id")
  actorLabel String?  @map("actor_label") // e-mail do painel, ou nome/telefone do operador
  action     String // ex.: report.email.sent
  status     String   @default("OK") // OK | ERROR
  entityType String?  @map("entity_type") // ex.: PROJECT
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
