{
  "name": "front-end-architecture",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "start": "vite",
    "lint": "biome check --write .",
    "format": "biome check --write --unsafe && biome format --write .",
    "check": "tsc --noEmit",
    "routes": "npx tsx src/lib/config/extract-routes.config.ts && pnpm run format",
    "routes:ai": "npx tsx src/lib/config/extract-routes-metadata.config.ts",
    "i18n": "python3 src/lib/config/translations/i18n_pipeline.py",
    "i18n:clean": "python3 src/lib/config/translations/i18n_remove_unused.py",
    "i18n:sort": "python3 src/lib/config/translations/i18n_sort.py",
    "i18n:dedupe": "python3 src/lib/config/translations/i18n_deduplicate.py",
    "i18n:check": "python3 src/lib/config/translations/i18n_check_missing.py",
    "i18n:validate": "python3 src/lib/config/translations/i18n_validate.py"
  },
