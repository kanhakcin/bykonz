generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationStep {
  MAIN_MENU
  ACTION_MENU
  SELECT_EMPRESA
  AWAITING_PHOTO
  AWAITING_DESCRIPTION
  AWAITING_INSPECT_DATE
  SELECT_EMPRESA_FOR_REPORT
  AWAITING_REPORT_DATE
  AWAITING_SERVICE_TYPE
  AWAITING_PROCEDURE_NUMBER
  SELECT_EMPRESA_FOR_TRAINING
  AWAITING_TRAINING_TEMA
  AWAITING_TRAINING_PARTICIPANTS
  AWAITING_TRAINING_DATES
  AWAITING_TRAINING_PHOTO
  AWAITING_TRAINING_FILE
}

model Usuario {
  id        Int      @id @default(autoincrement()) @db.SmallInt
  phoneE164 BigInt   @unique @map("PhoneE164") @db.BigInt
  nome      String?  @map("Nome")
  cargo     String?  @map("Cargo")
  createdAt DateTime @default(now()) @map("CreatedAt") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("UpdatedAt") @db.Timestamptz(6)

  empresas UserEmpresa[]
  entradas Entrada[]

  @@map("Usuarios")
}

model Empresa {
  id   BigInt  @id @default(autoincrement()) @db.BigInt
  nome String?

  usuarios UserEmpresa[]
  entradas Entrada[]

  @@map("Empresa")
}

model UserEmpresa {
  userId    Int    @map("User_ID") @db.SmallInt
  empresaId BigInt @map("Empresa_ID") @db.BigInt

  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@id([userId, empresaId])
  @@map("_UserEmpresa")
}

model Entrada {
  id                 BigInt   @id @default(autoincrement()) @db.BigInt
  userId             Int      @map("User_id") @db.SmallInt
  empresaId          BigInt?  @map("empresa_id") @db.BigInt
  description        String?  @map("Description")
  createdAt          DateTime @default(now()) @map("CreatedAt") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("UpdatedAt") @db.Timestamptz(6)
  tipo               String?  @map("Tipo")
  tipoServico        String?  @map("TipoServico")
  numeroProcedimento String?  @map("NumeroProcedimento")

  usuario     Usuario        @relation(fields: [userId], references: [id], onDelete: Restrict)
  empresa     Empresa?       @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  media       EntradaMedia[]
  treinamento Treinamento?

  @@map("Entrada")
}

model EntradaMedia {
  id        BigInt  @id @default(autoincrement()) @db.BigInt
  mediaUrl  String  @map("MediaUrl")
  mediaTipo String? @map("MediaTipo")
  entradaId BigInt  @map("Entrada_id") @db.BigInt

  entrada Entrada @relation(fields: [entradaId], references: [id], onDelete: Cascade)

  @@map("_EntradaMedia")
}

model Treinamento {
  id            Int      @id @default(autoincrement())
  entradaId     BigInt   @unique @map("Entrada_id") @db.BigInt
  tema          String   @map("Tema")
  participantes String?  @map("Participantes")
  inicio        DateTime @map("Inicio") @db.Timestamptz(6)
  fim           DateTime @map("Fim") @db.Timestamptz(6)

  entrada Entrada @relation(fields: [entradaId], references: [id], onDelete: Cascade)

  @@map("Treinamento")
}

model WhatsappConversationState {
  id                               BigInt           @id @default(autoincrement()) @db.BigInt
  chatId                           String           @unique @map("ChatId")
  phoneE164                        String           @map("PhoneE164")
  step                             ConversationStep @map("Step")
  flowKey                          String?          @map("FlowKey")
  stepKey                          String?          @map("StepKey")
  flowData                         Json?            @map("FlowData")
  selectedTipo                     String?          @map("SelectedTipo")
  selectedEmpresaId                BigInt?          @map("SelectedEmpresaId") @db.BigInt
  selectedTipoServico              String?          @map("SelectedTipoServico")
  selectedNumeroProcedimento       String?          @map("SelectedNumeroProcedimento")
  selectedTreinamentoTema          String?          @map("SelectedTreinamentoTema")
  selectedTreinamentoParticipantes String?          @map("SelectedTreinamentoParticipantes")
  selectedTreinamentoInicio        DateTime?        @map("SelectedTreinamentoInicio") @db.Timestamptz(6)
  selectedTreinamentoFim           DateTime?        @map("SelectedTreinamentoFim") @db.Timestamptz(6)
  selectedTrainingPhotoCount       Int?             @map("SelectedTrainingPhotoCount")
  pendingEntradaId                 BigInt?          @map("PendingEntradaId") @db.BigInt
  createdAt                        DateTime         @default(now()) @map("CreatedAt") @db.Timestamptz(6)
  updatedAt                        DateTime         @updatedAt @map("UpdatedAt") @db.Timestamptz(6)

  @@map("WhatsappConversationState")
}
