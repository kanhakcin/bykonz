# Config do backup nightly do Postgres — copie para backup.env e preencha.
#
#   cp backup.env.example backup.env
#   chmod 600 backup.env          # contém segredos
#
# NUNCA comite backup.env (já está no .gitignore).

# --- Banco -----------------------------------------------------------------
# Conexão do Postgres NATIVO de produção. pg_dump aceita a URI direto.
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO"

# Caminho do pg_dump, caso não esteja no PATH ou haja múltiplas versões.
# Ex.: /usr/lib/postgresql/16/bin/pg_dump
#PG_DUMP_BIN="pg_dump"

# --- Destino off-site (S3) -------------------------------------------------
# Bucket DEDICADO a backup — separado do bucket de mídia da app.
# Idealmente em outra região/conta. Veja README p/ criação + lifecycle + IAM.
BACKUP_S3_BUCKET="meu-bucket-backup-diario"
S3_PREFIX="db"

# Credenciais do aws-cli. Use uma IAM least-privilege (só PutObject no bucket
# de backup). Alternativa: deixar em branco e usar `aws configure`/instance role.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
# Só para S3-compatível não-AWS (MinIO, etc.). Em AWS, deixe em branco.
#AWS_S3_ENDPOINT=""

# --- Criptografia ----------------------------------------------------------
# gpg-passphrase : simétrico com senha (1 segredo — guarde a senha FORA da VPS).
# gpg-recipient  : assimétrico (chave pública no host; privada guardada off-site;
#                  RECOMENDADO — a VPS não consegue ler os próprios backups).
# none           : sem criptografia (NÃO recomendado — dump tem dados pessoais).
ENCRYPTION_MODE="gpg-passphrase"

# Para gpg-passphrase:
GPG_PASSPHRASE_FILE="/root/.diario-backup-pass"
# Para gpg-recipient (ID/e-mail/fingerprint da chave pública importada):
#GPG_RECIPIENT="backup@empresa.com.br"

# --- Retenção / sanidade ---------------------------------------------------
LOCAL_BACKUP_DIR="/var/backups/diario-db"
LOCAL_RETENTION_DAYS="7"      # retenção longa fica no S3 lifecycle (ver README)
MIN_DUMP_BYTES="5000"         # aborta se o dump vier pequeno demais

# --- Monitoramento de falha (dead man's switch) ----------------------------
# URL de um serviço tipo healthchecks.io / cron-ping. O script pinga no sucesso
# e em "/fail" na falha. Se o ping sumir, você recebe alerta.
#HEALTHCHECK_URL="https://hc-ping.com/SEU-UUID"
