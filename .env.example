NODE_ENV=development
PORT=8080

# PostgreSQL connection.
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:5432/[DATABASE]"

# Webhook authentication — gerar com: openssl rand -hex 32
WEBHOOK_SECRET="[gerar com: openssl rand -hex 32]"

# AWS S3 Storage.
ENDPOINT="https://s3.[REGION].amazonaws.com"
REGION="[AWS-REGION]"
ACCESS_KEY_ID="[AWS_ACCESS_KEY_ID]"
SECRET_ACCESS_KEY="[AWS_SECRET_ACCESS_KEY]"
S3_BUCKET="[BUCKET-NAME]"

# Canais de mensageria. WAHA (WhatsApp) e Telegram são opcionais e
# independentes — ambos podem rodar ao mesmo tempo —, mas exige-se pelo menos
# um configurado. Cada empresa escolhe qual canal usa (Company.activeChannel).

# WAHA (WhatsApp). Deixe as três vazias para desligar o canal WhatsApp.
WAHA_BASE_URL="http://localhost:3000"
WAHA_API_KEY="[WAHA_API_KEY]"
WAHA_SESSION="default"

# Telegram. Deixe TELEGRAM_BOT_TOKEN vazio para desligar o canal Telegram.
# Crie o bot no @BotFather e cole o token abaixo. O secret é o mesmo passado ao
# setWebhook e devolvido pelo Telegram no header X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET="[gerar com: openssl rand -hex 32]"

# Painel do gestor (API /api/v1). Sem PANEL_JWT_SECRET a API fica desabilitada.
# Gerar com: openssl rand -hex 32
PANEL_JWT_SECRET="[gerar com: openssl rand -hex 32]"
# Uma ou mais origens, separadas por vírgula
PANEL_CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
PANEL_TZ_OFFSET="-03:00"

# Usadas apenas para rodar `npm run seed:panel-admin` (cria o 1º usuário ADMIN)
PANEL_ADMIN_EMAIL="admin@empresa.com.br"
PANEL_ADMIN_PASSWORD="[senha forte, min. 8 caracteres]"
PANEL_ADMIN_NAME="Administrador"
