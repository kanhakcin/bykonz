NODE_ENV=development
PORT=8080

# Supabase Postgres for Prisma.
# Use Supavisor/session pooler for app connections and DIRECT_URL for migrations.
DATABASE_URL="postgresql://prisma.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase S3-compatible Storage.
ENDPOINT="https://[PROJECT-REF].storage.supabase.co/storage/v1/s3"
REGION="[PROJECT-REGION]"
ACCESS_KEY_ID="[S3_ACCESS_KEY_ID]"
SECRET_ACCESS_KEY="[S3_SECRET_ACCESS_KEY]"
SUPABASE_STORAGE_BUCKET="tatacon"

# WAHA.
WAHA_BASE_URL="http://localhost:3000"
WAHA_API_KEY="[WAHA_API_KEY]"
WAHA_SESSION="default"
